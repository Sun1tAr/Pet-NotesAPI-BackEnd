# Root redirect
location = /${REPO_NAME} {
return 301 /${REPO_NAME}/swagger-ui/index.html;}

# Trailing slash fix
location /${REPO_NAME} {
    return 301 /${REPO_NAME}/$request_uri;
}

# Main proxy с rewrite
location /${REPO_NAME}/ {
    rewrite ^/${REPO_NAME}/(.*) /$1 break;
    proxy_pass http://127.0.0.1:8888;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Prefix /${REPO_NAME};
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}
